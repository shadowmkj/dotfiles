.device internal {
  vendor:  0x0000,
  product: 0x0000,
}

.device gaming_keyboard {
  vendor:  0x258a,
  product: 0x0049,
}

# MacBook built-in remappings
.remap rcmd [device internal] : return
.remap ralt [device internal] : backspace

# External gaming keyboard remappings
.remap ralt [device gaming_keyboard] : return

# Browsers
hyper - b : open -na "Firefox"

# Development
hyper - 0x24 : open -a "Ghostty"

# Communication
hyper - d : open -a "Discord"
hyper - w : open -a "WhatsApp"

# System App
hyper - f : open -a "Finder"

hyper - e : /opt/homebrew/bin/fish -c "tnewc"

# Open password selector
hyper - p : /Users/milan/scripts/passmenu.sh

# -------------------------------------------------------------------
# Bookmark Modes (Chords)
# -------------------------------------------------------------------
:: bm_mode

# Enter 'bm_mode' with Hyper + H
hyper - h ; bm_mode

# Press 'a' to add a bookmark and return to default mode
bm_mode < a : skhd -k "escape"; /Users/milan/scripts/add-bookmark.sh

# Press 'h' to open bookmarks and return to default mode
bm_mode < h : skhd -k "escape"; /Users/milan/scripts/bookmark.sh

# Press Escape or Space to exit mode
bm_mode < escape ; default
bm_mode < space ; default


